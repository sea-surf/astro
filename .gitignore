# ============================================
# Git Ignore for Astro Crawler
# ============================================

# Bulk downloaded galleries & media (keep assets/ for readme preview)
imgs/
downloads/
output/
*.part
*.tmp

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/

# Package managers & tools cache
.uv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Environment variables & secrets
.env
.env.*
!.env.example

# Logs
*.log
logs/

# Operating System specific
# Windows
Thumbs.db
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# IDE & Code Editors
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
